{
  "manifest_version": 3,
  "name": "SignalLens for LinkedIn & X",
  "version": "0.8.0",
  "description": "Locally filters low-substance posts from LinkedIn and X on the web.",
  "permissions": ["storage", "downloads"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["http://127.0.0.1:11434/*", "http://localhost:11434/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SignalLens for LinkedIn & X",
    "default_popup": "popup.html"
  }
}
